PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Fast search. Without it the backend falls back to yt-dlp search (~2-3 s).
YOUTUBE_DATA_API_KEY=YOUR_YOUTUBE_DATA_API_KEY

# yt-dlp runs as a resident Python worker. `npm run setup` creates backend/.venv;
# override the interpreter only if you manage yt-dlp yourself.
# YT_DLP_PYTHON=/absolute/path/to/python
# YT_DLP_WORKERS=2
# YT_DLP_TIMEOUT_MS=30000

# Only if YouTube starts blocking extraction from this machine.
# YT_DLP_COOKIES_FROM_BROWSER=chrome
# YT_DLP_COOKIES_FILE=/absolute/path/to/cookies.txt
