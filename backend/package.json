{
  "name": "backend",
  "version": "1.0.0",
  "description": "Music app backend: YouTube search + yt-dlp stream extraction/proxy",
  "main": "dist/server.js",
  "scripts": {
    "setup": "python3 -m venv .venv && .venv/bin/pip install --quiet --upgrade yt-dlp",
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "ts-node -T test/smoke.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.2",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  }
}
