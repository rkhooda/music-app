# Optional. By default the app talks to the machine that serves the Metro bundle,
# on port 3000, so on a phone over Wi-Fi nothing needs to be set.
#
# Override the port only:
# EXPO_PUBLIC_API_PORT=3000
#
# Or point at a specific backend (a loopback host here is swapped for the Metro
# host automatically when running on a device):
# EXPO_PUBLIC_API_URL=http://192.168.1.50:3000
