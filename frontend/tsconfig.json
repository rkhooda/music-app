{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // SDK 57 nests expo-modules-core inside expo/, where tsc can't follow the
    // `import ... from 'expo-modules-core'` in expo-audio's types. Metro resolves it fine.
    "paths": {
      "expo-modules-core": ["./node_modules/expo/node_modules/expo-modules-core"]
    }
  }
}
